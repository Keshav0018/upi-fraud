# Copy this file to .env and fill in real values. .env is gitignored — never commit it.

# --- Postgres (payment-service only) ---
POSTGRES_DB=payments_db
POSTGRES_USER=payguard
POSTGRES_PASSWORD=payguard

# --- Background payment simulator (payment-service) ---
SIMULATOR_ENABLED=true
SIMULATOR_RATE_PER_SEC=1

# --- LLM provider (analytics-service) ---
# Pick ONE provider below and comment out the other. Both are OpenAI-compatible endpoints,
# so only these four env vars change between them — no code changes needed.

# Groq (default):
LLM_API_KEY=your-groq-api-key
LLM_BASE_URL=https://api.groq.com/openai
LLM_MODEL=llama-3.3-70b-versatile
LLM_COMPLETIONS_PATH=/v1/chat/completions

# Gemini (uncomment these four and comment out the Groq ones above):
# LLM_API_KEY=your-gemini-api-key
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# LLM_MODEL=gemini-2.5-flash
# LLM_COMPLETIONS_PATH=/chat/completions

AI_RATE_LIMIT_PER_MINUTE=20
AI_TIMEOUT_SECONDS=10

# --- Frontends ---
# Browsers load the frontends from the host, so this must be a host-reachable URL,
# not a Docker-internal hostname.
VITE_API_URL=http://localhost:8080
